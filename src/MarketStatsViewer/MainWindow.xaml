<Window x:Class="MarketStatsViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MarketStatsViewer.ViewModels"
        xmlns:controls="clr-namespace:MarketStatsViewer.Controls"
        mc:Ignorable="d"
        Title="Market Stats - Аналитический терминал объемов и микроструктуры QUIK" 
        Height="950" Width="1460"
        MinHeight="750" MinWidth="1180"
        Background="#0F172A"
        Foreground="#F8FAFC"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <vm:PriceChangeColorConverter x:Key="PriceChangeColorConverter" />
        <vm:SignedNumberConverter x:Key="SignedNumberConverter" />
        <vm:HexToBrushConverter x:Key="HexToBrushConverter" />

        <!-- Стилизация вкладок переключения видов (Графика vs Таблица) -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder" Background="{TemplateBinding Background}" CornerRadius="6,6,0,0" 
                                BorderBrush="#334155" BorderThickness="1,1,1,0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#0F172A" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка со стрелкой для выпадающего списка ToggleButton (полный темный стиль) -->
        <ControlTemplate x:Key="DarkComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="22" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4" 
                        Background="#1E293B" BorderBrush="#475569" BorderThickness="1" />
                <Border Grid.Column="0" Margin="1" Background="#1E293B" CornerRadius="3,0,0,3" />
                <Path x:Name="Arrow" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" 
                      Data="M 0 0 L 4 4 L 8 0 Z" Fill="#94A3B8" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#334155" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#0F172A" />
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Пункт выпадающего списка ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#334155" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#38BDF8" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Полный стиль ComboBox в темной теме (исключает белые системные элементы Windows) -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" 
                                          Template="{StaticResource DarkComboBoxToggleButton}" 
                                          Focusable="false" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press" />
                            <ContentPresenter Name="ContentSite" 
                                              IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}" 
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" 
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" 
                                              Margin="10,3,24,3" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left" />
                            <Popup Name="Popup" 
                                   Placement="Bottom" 
                                   IsOpen="{TemplateBinding IsDropDownOpen}" 
                                   AllowsTransparency="True" 
                                   Focusable="False" 
                                   PopupAnimation="Slide">
                                <Grid Name="DropDown" 
                                      SnapsToDevicePixels="True" 
                                      MinWidth="{TemplateBinding ActualWidth}" 
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" 
                                            Background="#1E293B" 
                                            BorderThickness="1" 
                                            BorderBrush="#475569" 
                                            CornerRadius="4" 
                                            Margin="0,2,0,0">
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="60" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="ForecastCardBorder" TargetType="Border">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="4" />
        </Style>

        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="CardBigValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <Style x:Key="CardSubValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>

        <!-- Custom Dark ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#1E293B" />
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />  <!-- Header / Controls -->
            <RowDefinition Height="Auto" />  <!-- KPI Summary Cards -->
            <RowDefinition Height="Auto" />  <!-- VSA Effort vs Result Banner -->
            <RowDefinition Height="Auto" />  <!-- Dual Horizon Forecast (2 Columns) -->
            <RowDefinition Height="*" />     <!-- Flow Data Grid -->
            <RowDefinition Height="Auto" />  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ROW 0: TOOLBAR / CONTROLS -->
        <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="14,8" Margin="4,0,4,8" BorderBrush="#334155" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Logo / Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="⚡" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="QUIK MARKET STATS" FontSize="16" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                    <TextBlock Text=" | Торговый аналитик объемов" FontSize="13" Foreground="#94A3B8" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <!-- Controls, Indicators and Buttons grouped cleanly on Right -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Instrument -->
                    <TextBlock Text="Инструмент:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableSecCodes}" 
                              SelectedItem="{Binding SelectedSecCode}"
                              Style="{StaticResource DarkComboBox}"
                              Width="105" Height="28" 
                              Margin="0,0,14,0" VerticalContentAlignment="Center" />

                    <!-- Session -->
                    <TextBlock Text="Сессия:" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12" />
                    <ComboBox ItemsSource="{Binding AvailableSessions}" 
                              SelectedItem="{Binding SelectedSession}"
                              Style="{StaticResource DarkComboBox}"
                              Width="180" Height="28" 
                              Margin="0,0,14,0" VerticalContentAlignment="Center" />

                    <!-- Live Indicator -->
                    <Border Background="#064E3B" BorderBrush="#10B981" BorderThickness="1" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,6,0" />
                            <TextBlock Text="LIVE ПОТОК" Foreground="#A7F3D0" FontSize="11" FontWeight="Bold" />
                        </StackPanel>
                    </Border>

                    <!-- Actions & Help Button -->
                    <Button Content="❓ Справка и термины" Command="{Binding ToggleHelpCommand}" 
                            Height="28" Padding="12,0" Background="#1E293B" Foreground="#38BDF8" BorderBrush="#38BDF8" Cursor="Hand" Margin="0,0,8,0" FontWeight="SemiBold" />
                    <Button Content="🔄 Обновить" Command="{Binding RefreshCommand}" 
                            Height="28" Padding="12,0" Background="#334155" Foreground="#F8FAFC" BorderBrush="#475569" Margin="0,0,8,0" Cursor="Hand" />
                    <Button Content="📥 Пересканировать базу" Command="{Binding ResyncAllHistoryCommand}" 
                            Height="28" Padding="10,0" Background="#1E293B" Foreground="#94A3B8" BorderBrush="#475569" Cursor="Hand" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 1: KPI CARDS WITH BENCHMARK COMPARISON -->
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Card 1: Last Price -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ПОСЛЕДНЯЯ ЦЕНА (CLOSE)" Style="{StaticResource CardHeader}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding LastPrice, StringFormat='{}{0:F1}'}" Style="{StaticResource CardBigValue}" />
                        <TextBlock Text="{Binding PriceChange, Converter={StaticResource SignedNumberConverter}}" 
                                   Foreground="{Binding PriceChange, Converter={StaticResource PriceChangeColorConverter}}"
                                   FontSize="14" FontWeight="Bold" Margin="8,4,0,0" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource CardSubValue}">
                        <Run Text="VWAP дня: " Foreground="#94A3B8"/>
                        <Run Text="{Binding DayVwap, StringFormat='{}{0:F1}'}" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 2: Day Volume with Full Day Comparison -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ДНЕВНОЙ ОБЪЕМ (VOL)" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding DayVolume, StringFormat='{}{0:N0} контр.'}" Style="{StaticResource CardBigValue}" />
                    <TextBlock Style="{StaticResource CardSubValue}" TextWrapping="Wrap" Margin="0,3,0,0">
                        <Run Text="{Binding VolumeComparisonText}" Foreground="#FBBF24" FontWeight="SemiBold" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 3: Trades Count & Avg Size with Benchmark -->
            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="СДЕЛКИ И СРЕДНИЙ РАЗМЕР" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding DayTrades, StringFormat='{}{0:N0} сдел.'}" Style="{StaticResource CardBigValue}" />
                    <TextBlock Style="{StaticResource CardSubValue}" TextWrapping="Wrap" Margin="0,3,0,0">
                        <Run Text="{Binding TradesComparisonText}" Foreground="#E2E8F0" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 4: Open Interest Delta -->
            <Border Grid.Column="3" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ИЗМЕНЕНИЕ ОТКРЫТОГО ИНТЕРЕСА" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding DayOiChange, Converter={StaticResource SignedNumberConverter}, StringFormat='{}{0} контр.'}" 
                               Foreground="{Binding DayOiChange, Converter={StaticResource PriceChangeColorConverter}}"
                               Style="{StaticResource CardBigValue}" />
                    <TextBlock Style="{StaticResource CardSubValue}">
                        <Run Text="С начала текущей сессии" Foreground="#94A3B8" />
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Card 5: Current Minute RVol -->
            <Border Grid.Column="4" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="ТЕКУЩИЙ RVOL (ПОСЛ. МИНУТА)" Style="{StaticResource CardHeader}" />
                    <TextBlock Text="{Binding CurrentRVol, StringFormat='{}{0:F2}x'}" 
                               Foreground="#38BDF8"
                               Style="{StaticResource CardBigValue}" />
                    <TextBlock Style="{StaticResource CardSubValue}">
                        <Run Text="Относительно нормы: " Foreground="#94A3B8" />
                        <Run Text="{Binding LastUpdateTime}" Foreground="#E2E8F0" />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ROW 2: VSA EFFORT VS RESULT BANNER -->
        <Border Grid.Row="2" Background="#1E293B" CornerRadius="8" Padding="14,10" Margin="4,2,4,6" 
                BorderBrush="{Binding EffortResult.BadgeColor, Converter={StaticResource HexToBrushConverter}}" 
                BorderThickness="1.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- VSA Badge -->
                <Border Grid.Column="0" 
                        Background="{Binding EffortResult.BadgeColor, Converter={StaticResource HexToBrushConverter}}" 
                        CornerRadius="6" Padding="12,6" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="{Binding EffortResult.Title}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                </Border>

                <!-- Description & Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding EffortResult.Summary}" FontSize="13" FontWeight="SemiBold" Foreground="#F1F5F9" TextWrapping="Wrap" />
                    <TextBlock Margin="0,3,0,0" FontSize="11" Foreground="#94A3B8">
                        <Run Text="{Binding EffortResult.Details}" />
                        <Run Text=" | Рекомендация: " Foreground="#CBD5E1" FontWeight="Bold" />
                        <Run Text="{Binding EffortResult.Recommendation}" Foreground="#E2E8F0" />
                    </TextBlock>
                </StackPanel>

                <!-- Stats summary -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                    <TextBlock Text="Усилие (RVol)" Foreground="#94A3B8" FontSize="11" HorizontalAlignment="Right" />
                    <TextBlock Text="{Binding EffortResult.EffortScore, StringFormat='{}{0:F2}x'}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ROW 3: DUAL HORIZON FORECAST (2 COLUMNS) -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- COLUMN 1: HORIZON 5-15 MIN -->
            <Border Grid.Column="0" Style="{StaticResource ForecastCardBorder}" 
                    BorderBrush="{Binding ForecastShort.DirectionColor, Converter={StaticResource HexToBrushConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ForecastShort.HorizonTitle}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="{Binding ForecastShort.HorizonSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Direction Badge -->
                        <Border Grid.Column="1" 
                                Background="{Binding ForecastShort.DirectionColor, Converter={StaticResource HexToBrushConverter}}" 
                                CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ForecastShort.Direction}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Probabilities Bars -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,8">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ВВЕРХ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastShort.ProbUp}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#10B981" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastShort.FormattedProbUp}" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ВНИЗ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastShort.ProbDown}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#EF4444" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastShort.FormattedProbDown}" FontSize="12" FontWeight="Bold" Foreground="#EF4444" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ФЛЭТ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastShort.ProbNeutral}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#64748B" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastShort.FormattedProbNeutral}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" />
                        </Grid>
                    </StackPanel>

                    <!-- Movement & Context -->
                    <Grid Grid.Row="2" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ForecastShort.RegimeSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ForecastShort.FormattedExpectedMove}" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Key Drivers & Confidence -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="10,6">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ForecastShort.KeyFactors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ForecastShort.ConfidenceText}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" FontStyle="Italic" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- COLUMN 2: HORIZON 30-60 MIN -->
            <Border Grid.Column="1" Style="{StaticResource ForecastCardBorder}"
                    BorderBrush="{Binding ForecastMedium.DirectionColor, Converter={StaticResource HexToBrushConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ForecastMedium.HorizonTitle}" FontSize="15" FontWeight="Bold" Foreground="#38BDF8" />
                            <TextBlock Text="{Binding ForecastMedium.HorizonSubtitle}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                        <!-- Direction Badge -->
                        <Border Grid.Column="1" 
                                Background="{Binding ForecastMedium.DirectionColor, Converter={StaticResource HexToBrushConverter}}" 
                                CornerRadius="6" Padding="12,5" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ForecastMedium.Direction}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" />
                        </Border>
                    </Grid>

                    <!-- Probabilities Bars -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,8">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ВВЕРХ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastMedium.ProbUp}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#10B981" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastMedium.FormattedProbUp}" FontSize="12" FontWeight="Bold" Foreground="#10B981" />
                        </Grid>

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ВНИЗ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastMedium.ProbDown}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#EF4444" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastMedium.FormattedProbDown}" FontSize="12" FontWeight="Bold" Foreground="#EF4444" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Вероятность ФЛЭТ:" FontSize="12" Foreground="#CBD5E1" />
                            <ProgressBar Grid.Column="1" Value="{Binding ForecastMedium.ProbNeutral}" Maximum="100" Height="10" 
                                         Margin="10,0" Foreground="#64748B" Background="#334155" BorderThickness="0" />
                            <TextBlock Grid.Column="2" Text="{Binding ForecastMedium.FormattedProbNeutral}" FontSize="12" FontWeight="Bold" Foreground="#94A3B8" />
                        </Grid>
                    </StackPanel>

                    <!-- Movement & Context -->
                    <Grid Grid.Row="2" Margin="0,4,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding ForecastMedium.RegimeSummary}" FontSize="12" FontWeight="SemiBold" Foreground="#F1F5F9" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding ForecastMedium.FormattedExpectedMove}" FontSize="13" FontWeight="Bold" Foreground="#FBBF24" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Key Drivers & Confidence -->
                    <Border Grid.Row="3" Background="#0F172A" CornerRadius="6" Padding="10,6">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ForecastMedium.KeyFactors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding ForecastMedium.ConfidenceText}" FontSize="10" Foreground="#64748B" Margin="0,4,0,0" FontStyle="Italic" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ROW 4: TABBED VIEW (CHARTS & FLOW TABLE) -->
        <TabControl Grid.Row="4" Margin="4,2,4,4">

            <!-- TAB 1: GRAPHICAL ANALYSIS DASHBOARD -->
            <TabItem Header="📊 Графический анализ (Свечи, VWAP, Профиль объема, ОИ, Темп дня)">
                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2.1*" />  <!-- Main Candlestick Chart + VWAP + Volume Profile -->
                        <RowDefinition Height="1*" />    <!-- Subcharts: Pace & Cumulative OI -->
                    </Grid.RowDefinitions>

                    <!-- Top Chart: Candlesticks + Volume + Volume Profile -->
                    <Border Grid.Row="0" Background="#1E293B" CornerRadius="8" Padding="4" Margin="0,0,0,4" BorderBrush="#334155" BorderThickness="1">
                        <controls:TradingChartControl Bars="{Binding AllDayBars}" 
                                                      VolumeProfile="{Binding VolumeProfileLevels}" />
                    </Border>

                    <!-- Bottom Split Charts: Intraday Pace & Open Interest -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Intraday Pace (Сегодня vs Норма) -->
                        <Border Grid.Column="0" Background="#1E293B" CornerRadius="8" Padding="4" Margin="0,0,2,0" BorderBrush="#334155" BorderThickness="1">
                            <controls:IntradayPaceChartControl Bars="{Binding AllDayBars}" 
                                                               Benchmarks="{Binding BenchmarksDictionary}" />
                        </Border>

                        <!-- Right: Cumulative Open Interest -->
                        <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="4" Margin="2,0,0,0" BorderBrush="#334155" BorderThickness="1">
                            <controls:OpenInterestChartControl Bars="{Binding AllDayBars}" />
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 2: DETAILED FLOW DATA GRID -->
            <TabItem Header="📋 Таблица потока минутных баров">
                <Border Background="#1E293B" CornerRadius="8" Padding="6" Margin="0,4,0,0" BorderBrush="#334155" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding RecentBars}" 
                              AutoGenerateColumns="False" 
                              IsReadOnly="True"
                              Background="Transparent"
                              RowBackground="#1E293B"
                              AlternatingRowBackground="#182234"
                              Foreground="#F8FAFC"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#334155"
                              HeadersVisibility="Column"
                              SelectionMode="Single"
                              CanUserSortColumns="False"
                              CanUserReorderColumns="False"
                              CanUserResizeRows="False">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#0F172A" />
                                <Setter Property="Foreground" Value="#94A3B8" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Padding" Value="8,6" />
                                <Setter Property="BorderBrush" Value="#334155" />
                                <Setter Property="BorderThickness" Value="0,0,0,1" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Height" Value="24" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ВРЕМЯ" Binding="{Binding Time}" Width="75" />
                            <DataGridTextColumn Header="OPEN" Binding="{Binding Open, StringFormat='{}{0:F1}'}" Width="65" />
                            <DataGridTextColumn Header="HIGH" Binding="{Binding High, StringFormat='{}{0:F1}'}" Width="65" />
                            <DataGridTextColumn Header="LOW" Binding="{Binding Low, StringFormat='{}{0:F1}'}" Width="65" />
                            <DataGridTextColumn Header="CLOSE" Binding="{Binding Close, StringFormat='{}{0:F1}'}" Width="65" FontWeight="SemiBold" />
                            <DataGridTextColumn Header="ДИАПАЗОН" Binding="{Binding PriceRange, StringFormat='{}{0:F1}'}" Width="75" />

                            <!-- Volume & Benchmark -->
                            <DataGridTextColumn Header="ОБЪЕМ" Binding="{Binding Volume, StringFormat='{}{0:N0}'}" Width="70" FontWeight="Bold" />
                            <DataGridTextColumn Header="НОРМА ВРЕМЕНИ" Binding="{Binding BenchmarkAvgVolume, StringFormat='{}{0:N0}'}" Width="95" Foreground="#94A3B8" />
                            <DataGridTextColumn Header="RVOL" Binding="{Binding RVol, StringFormat='{}{0:F2}x'}" Width="65" FontWeight="Bold" Foreground="#38BDF8" />

                            <!-- Trades & Size -->
                            <DataGridTextColumn Header="СДЕЛКИ" Binding="{Binding TradesCount}" Width="65" />
                            <DataGridTextColumn Header="СР. РАЗМЕР" Binding="{Binding AvgTradeSize, StringFormat='{}{0:F2}'}" Width="75" />

                            <!-- Open Interest -->
                            <DataGridTextColumn Header="ОИ ДЕЛЬТА" Binding="{Binding OpenInterestChange, Converter={StaticResource SignedNumberConverter}}" Width="80" FontWeight="SemiBold" />

                            <!-- VSA Effort vs Result Tag -->
                            <DataGridTemplateColumn Header="VSA УСИЛИЕ / РЕЗУЛЬТАТ" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding EffortResultColor, Converter={StaticResource HexToBrushConverter}}" 
                                                CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" Margin="2,1">
                                            <TextBlock Text="{Binding EffortResultTag}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>

        <!-- ROW 5: STATUS BAR -->
        <Border Grid.Row="5" Background="#0F172A" Padding="8,4" Margin="4,2,4,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusText}" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="MarketStats Analytics v1.1 • .NET 9" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
